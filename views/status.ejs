<%- include('partials/header') %>

<h2 class="mb-4">评测状态</h2>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>题目</th>
                        <th>用户</th>
                        <th>语言</th>
                        <th>状态</th>
                        <th>提交时间</th>
                        <th>详情</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (submissions.length === 0) { %>
                        <tr><td colspan="7" class="text-center py-3">暂无提交记录</td></tr>
                    <% } %>

                    <% submissions.forEach(function(s) { %>
                        <tr>
                            <td><%= s.id %></td>
                            <td>
                                <a href="/problem/<%= s.problemId %>" class="text-decoration-none">
                                    P<%= s.problemId %>
                                </a>
                            </td>
                            <td>
                                <a href="#" class="text-decoration-none"><%= s.username %></a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border"><%= s.language %></span>
                            </td>
                            <td>
                                <%
                                    const badgeMap = {
                                        'Accepted': 'bg-success',
                                        'Wrong Answer': 'bg-danger',
                                        'Time Limit Exceeded': 'bg-warning text-dark',
                                        'Runtime Error': 'bg-danger',
                                        'Output Limit Exceeded': 'bg-warning text-dark',
                                        'Compile Error': 'bg-secondary',
                                        'System Error': 'bg-dark',
                                    };
                                %>
                                <% if (s.status === 'Pending' || s.status === 'Running') { %>
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span class="text-primary"><%= s.status %></span>
                                <% } else { %>
                                    <span class="badge <%= badgeMap[s.status] || 'bg-secondary' %>"><%= s.status %></span>
                                <% } %>
                            </td>
                            <td class="text-muted small"><%= s.time %></td>
                            <td>
                                <!-- 如果登录了，且（是本人 或 是管理员）才能看详情，这里简单给个按钮，具体权限后端app.js已经做了拦截 -->
                                <% if (user) { %>
                                    <a href="/submission/<%= s.id %>" class="btn btn-sm btn-outline-primary">查看代码</a>
                                <% } else { %>
                                    <span class="text-muted small">需登录</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% if (totalPages > 1) { %>
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/status?page=<%= page - 1 %>">上一页</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link"><%= page %> / <%= totalPages %>（共 <%= total %> 条）</span>
            </li>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/status?page=<%= page + 1 %>">下一页</a>
            </li>
        </ul>
    </nav>
<% } %>

<!-- 存在未完成的提交时才自动刷新，避免无意义的整页刷新 -->
<% if ((submissions || []).some(s => s.status === 'Pending' || s.status === 'Running')) { %>
<script>
    setTimeout(function () {
        window.location.reload();
    }, 3000);
</script>
<% } %>

<%- include('partials/footer') %>
